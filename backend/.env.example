NODE_ENV=production
PORT=3000
POSTGRES_USER=my_db_user
POSTGRES_PASSWORD=my_secure_password
POSTGRES_DB=bhoomisetu
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
JWT_SECRET=generate_a_random_secure_secret_here
ASSAM_BHUNAKSHA_BASE_URL=https://bhunaksha.assam.gov.in/bhunakshaBackEnd
ASSAM_API_TIMEOUT_MS=10000
ASSAM_MAX_RETRIES=2
ASSAM_RETRY_BASE_DELAY_MS=250
ASSAM_STALE_AFTER_MS=86400000
ASSAM_STATE_CODE=AS
ASSAM_DEFAULT_DISTRICT_CODE=AS-KM
